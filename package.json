{
  "name": "inspirovate-creatives-storyloom",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "tsx scripts/database.ts seed-if-empty",
    "predev:web": "tsx scripts/database.ts seed-if-empty",
    "prestart": "NODE_ENV=production tsx scripts/database.ts seed-if-empty",
    "dev": "concurrently -k -n web,worker \"next dev --hostname 127.0.0.1\" \"tsx watch scripts/worker.ts\"",
    "dev:web": "next dev --hostname 127.0.0.1",
    "worker": "tsx scripts/worker.ts",
    "build": "next build",
    "start": "concurrently -k -n web,worker \"next start --hostname ${HOST:-0.0.0.0}\" \"tsx scripts/worker.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:migrate": "tsx scripts/database.ts migrate",
    "db:seed": "tsx scripts/database.ts seed",
    "prepare:fonts": "node scripts/fonts.mjs",
    "postinstall": "node scripts/fonts.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fontsource/inter": "^5.2.0",
    "@fontsource/lora": "^5.2.0",
    "@fontsource/montserrat": "^5.3.0",
    "@resvg/resvg-js": "2.6.2",
    "bcryptjs": "^3.0.2",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.0",
    "fontkit": "2.0.4",
    "jszip": "^3.10.1",
    "lucide-react": "^0.577.0",
    "next": "16.3.7",
    "openai": "^7.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "tsx": "^4.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.7",
    "@tailwindcss/postcss": "4.3.3",
    "@types/fontkit": "^2.0.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  },
  "overrides": {
    "shell-quote": "^1.12.0"
  },
  "engines": {
    "node": ">=24.11"
  }
}
