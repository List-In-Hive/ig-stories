# Required in production: the admin login password (12-72 characters).
ADMIN_PASSWORD=
DATA_DIR=./data
LOCAL_DEMO_ACCESS=false
# Default workspace time zone; it can also be changed in Settings > Automation.
TIME_ZONE=America/Los_Angeles
WORKER_CONCURRENCY=3
WORKER_MAX_ATTEMPTS=3
# demo or live. Settings > Integrations overrides this once saved.
PROVIDER_MODE=demo
# Live AI: Claude researches and writes, ChatGPT reviews, OpenAI paints backgrounds.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_REVIEW_MODEL=gpt-5.5
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
