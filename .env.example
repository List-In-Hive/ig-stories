# Required in production: the admin login password (12-72 characters).
ADMIN_PASSWORD=
DATA_DIR=./data
LOCAL_DEMO_ACCESS=false
# Default workspace time zone; it can also be changed in Settings > Automation.
TIME_ZONE=America/Los_Angeles
WORKER_CONCURRENCY=3
WORKER_MAX_ATTEMPTS=3
# demo or live. Settings > Integrations overrides this once saved.
PROVIDER_MODE=demo
# Live AI: Claude researches and writes, ChatGPT reviews, OpenAI paints backgrounds.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_REVIEW_MODEL=gpt-5.5
# Studies post photos in the project quick start; defaults to OPENAI_REVIEW_MODEL.
OPENAI_VISION_MODEL=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
# Free stock photos for story backgrounds. Get a key at https://pixabay.com/api/docs/
# (PEXELS_API_KEY also works if you have one). Leave empty to use only AI and brand photos.
PIXABAY_API_KEY=
# Optional: "Animate with AI" video stories (Runway, about $0.05 per second of video).
RUNWAYML_API_SECRET=
